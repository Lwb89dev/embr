# Maintainer: Lwb89dev <84742481+Lwb89dev@users.noreply.github.com>
#
# Development package: builds the current `main` of https://github.com/Lwb89dev/embr.
# (A release PKGBUILD with a pinned tarball and checksum follows the first tagged release.)
#
# Local build:   cd packaging/arch && makepkg -si
# Clean-chroot:  extra-x86_64-build   (devtools)

pkgname=embr-git
_pkgname=embr
pkgver=0.0.1.r0.g0000000
pkgrel=1
pkgdesc='Native Nostr signer: keys stay in one encrypted local process; apps ask it to sign (daemon, CLI and desktop app)'
arch=('x86_64' 'aarch64')
url='https://github.com/Lwb89dev/embr'
license=('MIT')
# The GUI loads these with dlopen (names read from the binary with `strings`, so `ldd`-based tools miss them).
depends=('glibc' 'gcc-libs' 'fontconfig' 'libglvnd' 'wayland' 'libxkbcommon' 'libxkbcommon-x11'
         'libx11' 'libxcursor' 'libxi' 'libxrender')
makedepends=('cargo' 'git')
# makepkg's default CFLAGS contain -flto; the `cc` crate would then build libsecp256k1 as LTO bitcode that
# rustc's linker cannot resolve (undefined rustsecp256k1_* symbols). Standard for Rust packages with C code.
options=('!lto')
provides=("$_pkgname=${pkgver%%.r*}")
conflicts=("$_pkgname")
install=embr-git.install
source=("$_pkgname::git+$url.git")
sha256sums=('SKIP')   # a git source cannot be pinned by checksum; pin a commit/tag for releases

pkgver() {
  cd "$_pkgname"
  printf '0.0.1.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p embrd -p embrctl -p embr-desktop
}

check() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen --workspace
}

package() {
  cd "$_pkgname"
  install -Dm755 target/release/embrd   -t "$pkgdir/usr/bin/"
  install -Dm755 target/release/embrctl -t "$pkgdir/usr/bin/"
  install -Dm755 target/release/embr    -t "$pkgdir/usr/bin/"
  install -Dm644 packaging/linux/embr.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 packaging/linux/embr.metainfo.xml -t "$pkgdir/usr/share/metainfo/"
  install -Dm644 packaging/linux/embr-tray-autostart.desktop -t "$pkgdir/usr/share/doc/$_pkgname/examples/"
  for size in 16 24 32 48 64 128 256 512; do
    install -Dm644 "packaging/icons/hicolor/${size}x${size}/apps/embr.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/embr.png"
  done
  install -Dm644 packaging/systemd/embrd.service -t "$pkgdir/usr/lib/systemd/user/"
  install -Dm644 packaging/systemd/embrd-remote.conf -t "$pkgdir/usr/share/doc/$_pkgname/examples/"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$_pkgname/"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$_pkgname/"
  install -Dm644 docs/*.md -t "$pkgdir/usr/share/doc/$_pkgname/docs/"
}
